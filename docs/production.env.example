# PeerDash production environment template

# Frontend origin, comma-separated if you use preview/staging domains too
CORS_ORIGIN="https://your-peerdash-domain.com"

# Public frontend variables
VITE_SIGNAL_SERVER_URL="https://your-peerdash-api.com"
VITE_API_URL="https://your-peerdash-api.com/api"
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Backend
NODE_ENV="production"
PORT=3001
API_BASE_URL="https://your-peerdash-api.com"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/peerdash?sslmode=require"
REDIS_URL="rediss://default:PASSWORD@HOST:6379"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# OAuth
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-peerdash-api.com/api/auth/google/callback"
APPLE_CLIENT_ID="com.yourcompany.peerdash"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"

# Payments / monetization hooks
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."

# TURN relay for hard NAT/firewall cases
TURN_SERVER_URL="turn:your-turn-host.com:3478"
TURN_USERNAME="turn-user"
TURN_PASSWORD="turn-password"

# Observability
LOG_LEVEL="info"
SENTRY_DSN=""

# Feature flags
FEATURE_E2E_ENCRYPTION="true"
FEATURE_GROUP_TRANSFERS="true"
FEATURE_CHAT="true"
FEATURE_LAN_DISCOVERY="true"
